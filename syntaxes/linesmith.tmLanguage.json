{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Linesmith",
  "scopeName": "source.linesmith",
  "patterns": [
    { "include": "#separator" },
    { "include": "#directive" },
    { "include": "#header-comment" }
  ],
  "repository": {
    "separator": {
      "match": "^\\s*---\\s*$",
      "name": "punctuation.definition.heading.linesmith keyword.control.separator.linesmith"
    },
    "directive": {
      "match": "^\\s*(@[a-zA-Z][a-zA-Z0-9_-]*)(.*)$",
      "captures": {
        "1": { "name": "keyword.other.directive.linesmith" },
        "2": { "name": "string.unquoted.directive-value.linesmith" }
      }
    },
    "header-comment": {
      "match": "^\\s*(#|//|<!--).*$",
      "name": "comment.line.linesmith"
    }
  }
}
