# example linesmith script — three chunks, typed into your target editor

import { useState, useEffect } from 'react';

---

const useFetch = (url) => {
  const [data, setData] = useState(null);

  useEffect(() => {
    fetch(url).then(r => r.json()).then(setData);
  }, [url]);

  return data;
}

---

export default useFetch;
